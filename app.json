{
  "expo": {
    "name": "audit-app",
    "slug": "audit-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auditapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.essilorluxottica.retailaudit",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/bf65f80f-a589-4957-b674-0143bdbdb9ab",
      "fallbackToCacheTimeout": 5000,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.0.0",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "description": "EssilorLuxottica Strategic Audit Platform",
      "backgroundColor": "#0A0F1E",
      "themeColor": "#C9A84C",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en-IN"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-updates",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share evidence of audit compliance.",
          "cameraPermission": "The app access your camera to let you take photos of audit compliance evidence."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/retail-audit-app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf65f80f-a589-4957-b674-0143bdbdb9ab"
      }
    }
  }
}
